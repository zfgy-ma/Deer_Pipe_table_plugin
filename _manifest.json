  "author": {
    "name": "追风观影",
    "url": "https://github.com/zfgy-ma"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/zfgy-ma/Deer_Pipe_table_plugin",
    "homepage": "https://github.com/zfgy-ma/Deer_Pipe_table_plugin",
    "documentation": "https://github.com/zfgy-ma/Deer_Pipe_table_plugin/blob/main/README.md",
    "issues": "https://github.com/zfgy-ma/Deer_Pipe_table_plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
